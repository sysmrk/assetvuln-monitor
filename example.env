# AssetVuln Monitor environment template
# ./install.sh automatically creates .env and generates unique passwords if absent.
# NEVER commit .env or real credentials.
# Generate each password independently: openssl rand -hex 30
HOST_UID=1000
HOST_GID=1000
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
APP_DB_PASSWORD=CHANGE_ME_APP
REPORT_DB_PASSWORD=CHANGE_ME_REPORT
MB_DB_PASSWORD=CHANGE_ME_METABASE_DB
METABASE_ADMIN_EMAIL=admin@example.local
METABASE_ADMIN_PASSWORD=CHANGE_ME_METABASE_ADMIN

# v0.3 is isolated from v0.1 and v0.2.
COMPOSE_PROJECT_NAME=assetvuln-monitor-v03

# HTTPS listens on loopback unless deliberately changed.
BIND_IP=127.0.0.1
HTTPS_PORT=8445
PUBLIC_URL=https://localhost:8445

# Optional Python package index for Docker image builds.
PIP_INDEX_URL=https://pypi.org/simple

# Demo: synthetic mappings; Live: switch to config/product-mappings.live.yaml
PRODUCT_MAPPINGS_FILE=./config/product-mappings.yaml
