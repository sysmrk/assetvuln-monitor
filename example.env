# AssetVuln Monitor environment template
# Copy to .env, edit BEFORE ./install.sh --demo or --live.
# NEVER commit .env or real credentials.
# Generate each password independently: openssl rand -hex 30
HOST_UID=1000
HOST_GID=1000
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES
APP_DB_PASSWORD=CHANGE_ME_APP
REPORT_DB_PASSWORD=CHANGE_ME_REPORT
MB_DB_PASSWORD=CHANGE_ME_METABASE_DB
METABASE_ADMIN_EMAIL=admin@example.local
METABASE_ADMIN_PASSWORD=CHANGE_ME_METABASE_ADMIN

# HTTPS listens on loopback unless deliberately changed.
BIND_IP=127.0.0.1
HTTPS_PORT=8443
PUBLIC_URL=https://localhost:8443

# Optional Python package index for Docker image builds.
PIP_INDEX_URL=https://pypi.org/simple
